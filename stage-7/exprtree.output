Grammar

    0 $accept: Program $end

    1 Program: TypeDefBlock ClassDefBlock GDeclBlock FDefBlock MainBlock
    2        | TypeDefBlock ClassDefBlock GDeclBlock MainBlock
    3        | TypeDefBlock ClassDefBlock MainBlock

    4 TypeDefBlock: TYPE TypeDefList ENDTYPE
    5             | %empty

    6 ClassDefBlock: CLASS ClassDefList ENDCLASS
    7              | %empty

    8 ClassDefList: ClassDefList ClassDef
    9             | ClassDef

   10 $@1: %empty

   11 ClassDef: ID $@1 '{' DECL ClassFieldList ClassMethodDeclList ENDDECL ClassMethodDefList '}'

   12 ClassFieldList: ClassFieldList ClassField
   13               | %empty

   14 ClassField: INT ID SEMICOLON
   15           | STR ID SEMICOLON
   16           | ID ID SEMICOLON

   17 ClassMethodDeclList: ClassMethodDeclList ClassMethodDecl
   18                    | ClassMethodDecl

   19 ClassMethodDecl: FType ID '(' ParamList ')' SEMICOLON

   20 ClassMethodDefList: ClassMethodDefList ClassMethodDef
   21                   | ClassMethodDef

   22 ClassMethodDef: FType ID '(' ParamList ')' '{' LdeclBlock Body '}'

   23 TypeDefList: TypeDefList TypeDef
   24            | TypeDef

   25 $@2: %empty

   26 TypeDef: ID '{' $@2 FieldDeclList '}'

   27 FieldDeclList: FieldDeclList FieldDecl
   28              | FieldDecl

   29 FieldDecl: FieldType ID SEMICOLON

   30 FieldType: INT
   31          | STR
   32          | ID

   33 GDeclBlock: DECL GDeclList ENDDECL
   34           | DECL ENDDECL

   35 GDeclList: GDeclList GDecl
   36          | GDecl

   37 GDecl: TypeName VarList SEMICOLON

   38 TypeName: INT
   39         | STR
   40         | ID

   41 FType: TypeName
   42      | TypeName MUL

   43 VarList: VarList ',' ID '[' NUM ']' '[' NUM ']'
   44        | ID '[' NUM ']' '[' NUM ']'
   45        | VarList ',' ID '[' NUM ']'
   46        | ID '[' NUM ']'
   47        | VarList ',' ID
   48        | ID
   49        | VarList ',' MUL ID
   50        | MUL ID
   51        | VarList ',' ID '(' ParamList ')'
   52        | ID '(' ParamList ')'
   53        | VarList ',' MUL ID '(' ParamList ')'
   54        | MUL ID '(' ParamList ')'

   55 Variable: ID
   56         | ID '[' E ']'
   57         | ID '[' E ']' '[' E ']'
   58         | MUL Variable

   59 Field: SELF '.' ID
   60      | Variable '.' ID
   61      | Field '.' ID

   62 FDefBlock: FDefBlock FDef
   63          | FDef

   64 $@3: %empty

   65 FDef: FType ID '(' ParamList ')' $@3 '{' LdeclBlock Body '}'

   66 ParamList: ParamList ',' Param
   67          | Param
   68          | %empty

   69 Param: TypeName ID
   70      | TypeName MUL ID

   71 LdeclBlock: DECL LDecList ENDDECL
   72           | DECL ENDDECL

   73 LDecList: LDecList LDecl
   74         | LDecl

   75 LDecl: TypeName IdList SEMICOLON

   76 IdList: IdList ',' ID
   77       | IdList ',' ID '[' NUM ']'
   78       | IdList ',' ID '[' NUM ']' '[' NUM ']'
   79       | ID '[' NUM ']'
   80       | ID '[' NUM ']' '[' NUM ']'
   81       | ID

   82 ArgList: ArgList ',' E
   83        | E

   84 Body: T_BEGIN Slist ReturnStmt T_END
   85     | T_BEGIN ReturnStmt T_END

   86 ReturnStmt: RETURN E SEMICOLON

   87 $@4: %empty

   88 MainBlock: INT MAIN '(' ')' '{' $@4 LdeclBlock Body '}'

   89 Slist: Slist Stmt
   90      | Stmt

   91 Stmt: InputStmt
   92     | OutputStmt
   93     | AsgStmt
   94     | IfStmt
   95     | WhileStmt
   96     | BreakStmt
   97     | ContinueStmt
   98     | RepeatStmt
   99     | DoWhileStmt
  100     | Variable ASSIGN ALLOC '(' ')' SEMICOLON
  101     | Field ASSIGN ALLOC '(' ')' SEMICOLON
  102     | Variable ASSIGN NEW '(' ID ')' SEMICOLON
  103     | Field ASSIGN NEW '(' ID ')' SEMICOLON
  104     | FREE '(' ID ')' SEMICOLON
  105     | FREE '(' Field ')' SEMICOLON
  106     | DELETE '(' Variable ')' SEMICOLON
  107     | DELETE '(' Field ')' SEMICOLON

  108 InputStmt: READ '(' Variable ')' SEMICOLON
  109          | READ '(' Field ')' SEMICOLON

  110 OutputStmt: WRITE '(' E ')' SEMICOLON

  111 AsgStmt: Variable ASSIGN E SEMICOLON
  112        | Field ASSIGN E SEMICOLON

  113 IfStmt: IF '(' E ')' THEN Slist ELSE Slist ENDIF SEMICOLON
  114       | IF '(' E ')' THEN Slist ENDIF SEMICOLON

  115 WhileStmt: WHILE '(' E ')' DO Slist ENDWHILE SEMICOLON

  116 BreakStmt: BREAK SEMICOLON

  117 ContinueStmt: CONTINUE SEMICOLON

  118 RepeatStmt: REPEAT Slist UNTIL '(' E ')' SEMICOLON

  119 DoWhileStmt: DO Slist WHILE '(' E ')' SEMICOLON

  120 E: E PLUS E
  121  | E MINUS E
  122  | E MUL E
  123  | E DIV E
  124  | E MOD E
  125  | MINUS E
  126  | '(' E ')'
  127  | E LT E
  128  | E GT E
  129  | E LE E
  130  | E GE E
  131  | E EQ E
  132  | E NE E
  133  | E OR E
  134  | E AND E
  135  | NUM
  136  | STRING
  137  | T_NULL
  138  | ADDRESS Variable
  139  | Variable
  140  | Field
  141  | FieldFunction
  142  | ID '(' ')'
  143  | ID '(' ArgList ')'

  144 FieldFunction: Field '(' ArgList ')'
  145              | Field '(' ')'


